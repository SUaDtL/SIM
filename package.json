{
  "name": "sim",
  "version": "0.0.0",
  "description": "SIM - Service Integration Map: offline single-file service and network visualization",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm test && npm run e2e"
  },
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "cytoscape": "3.34.4",
    "cytoscape-fcose": "2.2.0",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/cytoscape-fcose": "2.2.5",
    "@types/node": "^26.6.6",
    "@types/sql.js": "^1.4.11",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
